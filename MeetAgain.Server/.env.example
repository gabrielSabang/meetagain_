# MongoDB Atlas connection strings.
# Primary is tried first; fallback is used only if primary fails with an authentication error.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?appName=<app>
MONGODB_URI_FALLBACK=mongodb+srv://<user>:<password>@<cluster>/?appName=<app>
MONGODB_DATABASE=meetagain

# JWT signing key (min 32 chars) for self-issued tokens.
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_MINUTES=10080

# Comma-separated list of allowed CORS origins.
ALLOWED_ORIGINS=http://localhost:5082,https://localhost:7155

# Firestore migration source (migration tool only).
# FIRESTORE_PROJECT_ID=meetagain-50f2b
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-adminsdk.json
