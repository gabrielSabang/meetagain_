@page "/diagnostic"
@using MongoDB.Driver
@inject FriendService FriendService
@inject MeetupService MeetupService
@inject AuthService AuthService
@inject MeetAgain.Server.Services.Mongo.MongoDbContext Mongo

<PageTitle>MongoDB Diagnostic</PageTitle>

<div class="container mt-4">
    <div class="card fade-in">
        <div class="card-header">
            <h2 class="card-title">🔍 MongoDB Connection Diagnostic</h2>
            <p style="color: var(--gray-600); margin: 0.5rem 0 0 0; font-size: 0.875rem;">
                This tool checks if your data is persisting correctly to MongoDB
            </p>
        </div>
        <div class="card-body">
            <button class="btn btn-primary" @onclick="RunDiagnostic" disabled="@isRunning">
                @if (isRunning)
                {
                    <span class="loading-spinner" style="width: 1rem; height: 1rem; margin-right: 0.5rem;"></span>
                }
                🔍 Run Diagnostic
            </button>

            @if (results.Count > 0)
            {
                <div style="margin-top: 2rem;">
                    <h3 style="margin-bottom: 1rem;">📊 Results:</h3>
                    @foreach (var result in results)
                    {
                        <div class="@GetResultClass(result.Status)" style="padding: 1rem; margin-bottom: 0.5rem; border-radius: var(--radius);">
                            <div style="display: flex; justify-content: space-between; align-items: start;">
                                <div style="flex: 1;">
                                    <strong>@result.Test:</strong> @result.Message
                                </div>
                                <span style="font-size: 1.25rem; margin-left: 1rem;">
                                    @(result.Status == "success" ? "✅" : result.Status == "error" ? "❌" : "ℹ️")
                                </span>
                            </div>
                        </div>
                    }
                </div>

                @if (friendsData.Count > 0)
                {
                    <div style="margin-top: 2rem;">
                        <h3 style="margin-bottom: 1rem;">👥 Friends Data in MongoDB:</h3>
                        <div style="background: var(--gray-50); padding: 1rem; border-radius: var(--radius); font-family: monospace; font-size: 0.875rem; max-height: 300px; overflow-y: auto;">
                            @foreach (var friend in friendsData)
                            {
                                <div style="margin-bottom: 0.5rem; padding: 0.5rem; background: white; border-radius: 0.25rem;">
                                    <strong style="color: var(--primary);">@friend.Key:</strong>
                                    <br />
                                    <span style="color: var(--gray-700);">@friend.Value</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (meetupsData.Count > 0)
                {
                    <div style="margin-top: 2rem;">
                        <h3 style="margin-bottom: 1rem;">📅 Meetups Data in MongoDB:</h3>
                        <div style="background: var(--gray-50); padding: 1rem; border-radius: var(--radius); font-family: monospace; font-size: 0.875rem; max-height: 300px; overflow-y: auto;">
                            @foreach (var meetup in meetupsData)
                            {
                                <div style="margin-bottom: 0.5rem; padding: 0.5rem; background: white; border-radius: 0.25rem;">
                                    <strong style="color: var(--success);">@meetup.Key:</strong>
                                    <br />
                                    <span style="color: var(--gray-700);">@meetup.Value</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div style="margin-top: 2rem; padding: 1rem; background: var(--gray-50); border-radius: var(--radius);">
                    <h4 style="margin-bottom: 0.5rem;">💡 Tips:</h4>
                    <ul style="margin: 0; padding-left: 1.5rem; color: var(--gray-700);">
                        <li>Check <code>GET /health</code> for collection counts</li>
                        <li>If friends show 0 but you added some, they might not be persisting</li>
                        <li>Check MongoDB Atlas → Database → Collections to verify data</li>
                        <li>Make sure you're using the same user account when testing</li>
                    </ul>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private bool isRunning = false;
    private List<DiagnosticResult> results = new();
    private Dictionary<string, string> friendsData = new();
    private Dictionary<string, string> meetupsData = new();

    private class DiagnosticResult
    {
        public string Test { get; set; } = "";
        public string Message { get; set; } = "";
        public string Status { get; set; } = "info"; // success, error, info
    }

    private async Task RunDiagnostic()
    {
        isRunning = true;
        results.Clear();
        friendsData.Clear();
        meetupsData.Clear();

        try
        {
            var userId = AuthService.UserId;
            if (string.IsNullOrEmpty(userId))
            {
                results.Add(new DiagnosticResult { Test = "Authentication", Message = "Not authenticated. Please log in first.", Status = "error" });
                return;
            }
            results.Add(new DiagnosticResult { Test = "Authentication", Message = $"Authenticated as: {userId}", Status = "success" });

            try
            {
                await Mongo.Database.RunCommandAsync<MongoDB.Bson.BsonDocument>(new MongoDB.Bson.BsonDocument("ping", 1));
                results.Add(new DiagnosticResult { Test = "MongoDB Connection", Message = $"Connected to '{Mongo.DatabaseName}' (fallback: {Mongo.UsedFallback})", Status = "success" });

                var user = await Mongo.Users.Find(u => u.Uid == userId).FirstOrDefaultAsync();
                results.Add(new DiagnosticResult
                {
                    Test = "User Document",
                    Message = user != null ? $"User document exists for: {user.DisplayName}" : "User document does not exist in MongoDB.",
                    Status = user != null ? "success" : "error",
                });
            }
            catch (Exception ex)
            {
                results.Add(new DiagnosticResult { Test = "MongoDB Connection", Message = $"Error connecting: {ex.Message}", Status = "error" });
            }

            try
            {
                var friends = await FriendService.GetFriendsAsync();
                results.Add(new DiagnosticResult { Test = "Friends Collection", Message = $"Found {friends.Count} friend(s) in MongoDB", Status = friends.Count > 0 ? "success" : "info" });
                foreach (var f in friends)
                    friendsData.TryAdd($"Friend: {f.Name}", $"Email: {f.Email}, Added: {f.AddedAt}");
            }
            catch (Exception ex)
            {
                results.Add(new DiagnosticResult { Test = "Friends Collection", Message = $"Error reading friends: {ex.Message}", Status = "error" });
            }

            try
            {
                var requests = await FriendService.GetFriendRequestsAsync();
                results.Add(new DiagnosticResult { Test = "Friend Requests", Message = $"Found {requests.Count} pending friend request(s)", Status = "info" });
            }
            catch (Exception ex)
            {
                results.Add(new DiagnosticResult { Test = "Friend Requests", Message = $"Error: {ex.Message}", Status = "error" });
            }

            try
            {
                var meetups = await MeetupService.GetMyMeetupsAsync();
                results.Add(new DiagnosticResult { Test = "My Meetups", Message = $"You are participating in {meetups.Count} meetup(s)", Status = meetups.Count > 0 ? "success" : "info" });
                foreach (var m in meetups)
                    meetupsData.TryAdd($"Meetup: {m.Title}", $"Creator: {m.CreatorName}, Status: {m.MyRSVPStatus}, Participants: {m.ParticipantCount}");
            }
            catch (Exception ex)
            {
                results.Add(new DiagnosticResult { Test = "Meetups Collection", Message = $"Error: {ex.Message}", Status = "error" });
            }

            try
            {
                var id = $"diag:{Guid.NewGuid():N}";
                await Mongo.Notifications.InsertOneAsync(new MeetAgain.Server.Models.Notification
                {
                    Id = id, UserId = userId, Type = "diagnostic", Message = "write permission check",
                    CreatedAt = DateTime.UtcNow.ToString("o"), IsRead = true,
                });
                await Mongo.Notifications.DeleteOneAsync(n => n.Id == id);
                results.Add(new DiagnosticResult { Test = "Write Permissions", Message = "Can write to MongoDB successfully", Status = "success" });
            }
            catch (Exception ex)
            {
                results.Add(new DiagnosticResult { Test = "Write Permissions", Message = $"Cannot write: {ex.Message}", Status = "error" });
            }
        }
        finally
        {
            isRunning = false;
        }
    }

    private string GetResultClass(string status)
    {
        return status switch
        {
            "success" => "alert-success",
            "error" => "alert-error",
            _ => "alert-info"
        };
    }
}

<style>
    .alert-success { background: #D1FAE5; border-left: 4px solid var(--success); color: #065F46; }
    .alert-error { background: #FEE2E2; border-left: 4px solid var(--danger); color: #991B1B; }
    .alert-info { background: #DBEAFE; border-left: 4px solid #3B82F6; color: #1E40AF; }
</style>
