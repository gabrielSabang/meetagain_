@page "/dashboard"
@using MeetAgain.Server.Models
@using MeetAgain.Server.Services
@using MeetAgain.Server.Services.Mongo
@using MongoDB.Driver
@inject MeetupService MeetupService
@inject FriendService FriendService
@inject GroupService GroupService
@inject AuthService Auth
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject MongoDbContext Mongo

<PageTitle>Dashboard - MeetAgain</PageTitle>

@if (loading)
{
    <div class="loading-container">
        <div class="loading-spinner"></div>
        <p style="margin-top: 1rem; color: var(--gray-600);">Loading your dashboard...</p>
    </div>
}
else
{
    <!-- Welcome Section -->
    <div class="welcome-section fade-in">
        <h1>Welcome back, @displayName! 👋</h1>
        <p>Here's what's happening with your meetups and connections</p>
    </div>

    <!-- Stats Grid -->
    <div class="stats-grid fade-in">
        <div class="stat-card upcoming">
            <div class="stat-label">Upcoming Meetups</div>
            <div class="stat-value">@upcoming.Count</div>
            <div class="stat-description">
                @if (upcoming.Any())
                {
                    <span>Next: @upcoming.First().EventDateTime.ToLocalTime().ToString("MMM dd")</span>
                }
                else
                {
                    <span>No meetups scheduled</span>
                }
            </div>
        </div>

        <div class="stat-card friends">
            <div class="stat-label">Friends</div>
            <div class="stat-value">@friendCount</div>
            <div class="stat-description">Active connections</div>
        </div>

        <div class="stat-card groups">
            <div class="stat-label">Groups</div>
            <div class="stat-value">@groupCount</div>
            <div class="stat-description">Communities you're part of</div>
        </div>

        <div class="stat-card">
            <div class="stat-label">Total Meetups</div>
            <div class="stat-value">@meetups.Count</div>
            <div class="stat-description">All time</div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="card fade-in">
        <div class="card-header">
            <h2 class="card-title">Quick Actions</h2>
        </div>
        <div class="flex space-x-4">
            <a href="/create-meetup" class="btn btn-primary">
                ➕ Create Meetup
            </a>
            <a href="/friends" class="btn btn-secondary">
                👥 Manage Friends
            </a>
            <a href="/groups" class="btn btn-outline">
                👨‍👩‍👧‍👦 View Groups
            </a>
        </div>
    </div>

    <!-- Upcoming Meetups Section -->
    <div class="card fade-in">
        <div class="card-header">
            <h2 class="card-title">Upcoming Meetups</h2>
            @if (upcoming.Any())
            {
                <a href="/meetups" style="color: var(--primary); font-weight: 600; font-size: 0.875rem; text-decoration: none;">
                    View All →
                </a>
            }
        </div>

        @if (!upcoming.Any())
        {
            <div class="empty-state">
                <div class="empty-state-icon">📅</div>
                <h3 class="empty-state-title">No Upcoming Meetups</h3>
                <p class="empty-state-description">
                    Create your first meetup and start connecting with friends!
                </p>
                <a href="/create-meetup" class="btn btn-primary">
                    Create Your First Meetup
                </a>
            </div>
        }
        else
        {
            <div class="space-y-3">
                @foreach (var meetup in upcoming.Take(5))
                {
                    <a href="/meetups" class="meetup-card" style="text-decoration: none; color: inherit; display: block;">
                        <div class="meetup-title">@meetup.Title</div>
                        @if (!string.IsNullOrEmpty(meetup.Description))
                        {
                            <p style="color: var(--gray-600); font-size: 0.875rem; margin-top: 0.25rem;">
                                @(meetup.Description.Length > 100 
                                    ? meetup.Description.Substring(0, 100) + "..." 
                                    : meetup.Description)
                            </p>
                        }
                        <div class="meetup-date">
                            @meetup.EventDateTime.ToLocalTime().ToString("MMMM dd, yyyy 'at' h:mm tt")
                        </div>
                        <div style="margin-top: 0.5rem; display: flex; gap: 0.5rem; align-items: center;">
                            @if (meetup.IsCreator)
                            {
                                <span class="badge" style="background: var(--success); color: white; font-size: 0.75rem; padding: 0.25rem 0.5rem; border-radius: 0.25rem;">
                                    Created by you
                                </span>
                            }
                            else
                            {
                                <span class="badge" style="background: var(--primary); color: white; font-size: 0.75rem; padding: 0.25rem 0.5rem; border-radius: 0.25rem;">
                                    Invited
                                </span>
                            }
                            @if (!string.IsNullOrEmpty(meetup.MyRSVPStatus))
                            {
                                <span class="badge" style="background: var(--gray-600); color: white; font-size: 0.75rem; padding: 0.25rem 0.5rem; border-radius: 0.25rem;">
                                    @meetup.MyRSVPStatus
                                </span>
                            }
                        </div>
                    </a>
                }
            </div>

            @if (upcoming.Count > 5)
            {
                <div style="margin-top: 1rem; text-align: center;">
                    <a href="/meetups" class="btn btn-outline btn-sm">
                        View All @upcoming.Count Meetups
                    </a>
                </div>
            }
        }
    </div>

    <!-- Recent Activity / Past Meetups -->
    @if (past.Any())
    {
        <div class="card fade-in">
            <div class="card-header">
                <h2 class="card-title">Recent Past Meetups</h2>
            </div>
            <div class="space-y-3">
                @foreach (var meetup in past.Take(3))
                {
                    <div class="meetup-card" style="opacity: 0.8;">
                        <div class="meetup-title">@meetup.Title</div>
                        <div class="meetup-date" style="color: var(--gray-500);">
                            @meetup.EventDateTime.ToLocalTime().ToString("MMMM dd, yyyy 'at' h:mm tt")
                        </div>
                        <div style="margin-top: 0.5rem;">
                            <span class="badge" style="background: var(--gray-400); color: white; font-size: 0.75rem; padding: 0.25rem 0.5rem; border-radius: 0.25rem;">
                                Completed
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}

<style>
    /* Make links look like buttons */
    a.btn {
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
</style>

@code {
    private List<MeetupDto> meetups = new();
    private List<MeetupDto> upcoming = new();
    private List<MeetupDto> past = new();
    private int friendCount = 0;
    private int groupCount = 0;
    private string displayName = "User";
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Console.WriteLine("=== Dashboard Initialization Started ===");
            
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var principal = authState.User;

            if (principal?.Identity?.IsAuthenticated != true)
            {
                Console.WriteLine("Dashboard: User not authenticated, redirecting to login");
                Nav.NavigateTo("/login");
                return;
            }

            // Try multiple methods to get user ID
            var userId = principal.FindFirst(c => c.Type == "user_id")?.Value;
            if (string.IsNullOrEmpty(userId))
            {
                userId = principal.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            }
            if (string.IsNullOrEmpty(userId))
            {
                userId = principal.FindFirst(c => c.Type == "sub")?.Value;
            }

            Console.WriteLine($"Dashboard: Retrieved userId = {userId}");

            // LOAD USERNAME FROM MONGODB
            if (!string.IsNullOrEmpty(userId))
            {
                try
                {
                    Console.WriteLine($"Dashboard: Fetching user document from MongoDB for userId: {userId}");

                    var user = await Mongo.Users.Find(u => u.Uid == userId).FirstOrDefaultAsync();

                    if (user != null)
                    {
                        // Try DisplayName first
                        if (!string.IsNullOrWhiteSpace(user.DisplayName))
                        {
                            displayName = user.DisplayName;
                            Console.WriteLine($"Dashboard: Loaded DisplayName from MongoDB: {displayName}");
                        }
                        // Fallback to Email if DisplayName is empty
                        else if (!string.IsNullOrWhiteSpace(user.Email))
                        {
                            displayName = user.Email;
                            Console.WriteLine($"Dashboard: DisplayName empty, using Email: {displayName}");
                        }
                        else
                        {
                            displayName = "User";
                            Console.WriteLine("Dashboard: Both DisplayName and Email are empty, using 'User'");
                        }
                    }
                    else
                    {
                        Console.WriteLine($"Dashboard: User document does not exist in MongoDB for userId: {userId}");
                        // Fallback to email from claims
                        var email = principal.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value;
                        displayName = !string.IsNullOrEmpty(email) ? email : "User";
                        Console.WriteLine($"Dashboard: Using email from claims: {displayName}");
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Dashboard: ERROR loading user data from MongoDB - {ex.Message}");
                    Console.WriteLine($"Dashboard: Stack trace: {ex.StackTrace}");
                    
                    // Final fallback to claims
                    var email = principal.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value;
                    displayName = !string.IsNullOrEmpty(email) ? email : "User";
                    Console.WriteLine($"Dashboard: Using fallback from claims: {displayName}");
                }
            }
            else
            {
                Console.WriteLine("Dashboard: No userId found in claims");
                displayName = "User";
            }

            // LOAD MEETUPS
            Console.WriteLine("Dashboard: Loading meetups...");
            meetups = await MeetupService.GetMyMeetupsAsync() ?? new();
            Console.WriteLine($"Dashboard: Loaded {meetups.Count} meetups");

            // LOAD FRIENDS
            try
            {
                Console.WriteLine("Dashboard: Loading friends...");
                var friends = await FriendService.GetFriendsAsync();
                friendCount = friends?.Count ?? 0;
                Console.WriteLine($"Dashboard: Loaded {friendCount} friends");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Dashboard: Error loading friends - {ex.Message}");
                friendCount = 0;
            }

            // LOAD GROUPS
            try
            {
                Console.WriteLine("Dashboard: Loading groups...");
                var groups = await GroupService.GetMyGroupsAsync();
                groupCount = groups?.Count ?? 0;
                Console.WriteLine($"Dashboard: Loaded {groupCount} groups");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Dashboard: Error loading groups - {ex.Message}");
                groupCount = 0;
            }

            // CATEGORIZE MEETUPS
            var now = DateTime.Now;
            upcoming = meetups
                .Where(m => m.EventDateTime.ToLocalTime() > now)
                .OrderBy(m => m.EventDateTime)
                .ToList();

            past = meetups
                .Where(m => m.EventDateTime.ToLocalTime() <= now)
                .OrderByDescending(m => m.EventDateTime)
                .ToList();

            Console.WriteLine($"Dashboard: {upcoming.Count} upcoming, {past.Count} past meetups");
            Console.WriteLine($"=== Dashboard Initialization Complete ===");
            Console.WriteLine($"Final displayName: {displayName}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Dashboard: FATAL ERROR - {ex.Message}");
            Console.WriteLine($"Dashboard: Stack trace - {ex.StackTrace}");
            displayName = "User";
        }
        finally
        {
            loading = false;
        }
    }
}